{
  "name": "nova-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/desktop.mjs --dev",
    "build": "tsc -b && vite build && node scripts/build-desktop.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run typecheck && npm run lint",
    "test": "node --test tests/*.test.ts",
    "start": "node scripts/desktop.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:desktop": "npm run build && node scripts/test-desktop.mjs",
    "test:sidebar": "npm run build && node scripts/test-desktop.mjs --sidebar",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.9.0",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "shadcn": "4.22.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "license": "MIT",
  "author": "NovaTerminal contributors",
  "description": "Local-first SSH client with independent terminal sessions",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.19.1 <12"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": false,
    "cpu-features@0.0.10": false,
    "esbuild@0.28.2": true
  },
  "main": "out/electron/main.cjs"
}
